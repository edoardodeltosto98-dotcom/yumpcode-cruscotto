# Clerk (autenticazione B2B multi-tenant). Chiavi da clerk.com > Configure > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# URL delle pagine di accesso/registrazione: gia' impostate qui, non serve toccarle
# a meno di spostare le pagine sotto un altro percorso.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (database multi-tenant). Da supabase.com > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://djizucxcratopxebuyjn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend assistente-core. Facoltativo in locale (default http://localhost:3001),
# obbligatorio in produzione con l'URL reale del backend.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
